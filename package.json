{
  "name": "expo-kit",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.8.2",
      "@orpc/server": "^1.10.0",
      "@orpc/openapi": "^1.10.0",
      "@orpc/zod": "^1.10.0",
      "better-auth": "^1.3.28",
      "dotenv": "^17.2.2",
      "zod": "^4.1.11",
      "tsdown": "^0.15.5"
    }
  },
  "scripts": {
    "📦": "──────────────── Workspace Shortcuts ────────────────",
    "dev": "bun run --filter '*' dev",
    "app": "bun --filter mobile",
    "srv": "bun --filter server",
    "db": "bun --filter @repo/db",
    "✨": "──────────────── Hygiene ────────────────",
    "lint": "biome lint",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check-types": "bun run --filter '*' check-types"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "tsdown": "^0.15.12",
    "@types/bun": "^1.3.2"
  },
  "packageManager": "bun@1.3.1"
}
