{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "hono": "^4.10.6",
    "@orpc/server": "^1.11.2",
    "@orpc/openapi": "^1.11.2",
    "@orpc/zod": "^1.11.2",
    "better-auth": "^1.3.34",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12",
    "@repo/api": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.2",
    "tsdown": "^0.15.12"
  }
}
